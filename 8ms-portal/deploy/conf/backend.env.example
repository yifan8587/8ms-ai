# ============================================================
#  AI 智枢平台 后端运行时环境变量（Django + Gunicorn）
#  部署脚本会把此文件复制到 /etc/aiprogram/backend.env
#  并由 systemd（aiprogram-backend.service）加载
# ============================================================

# ──── Django ─────────────────────────────────────────────────
# 32 字节随机字符串，部署脚本首次安装时自动生成
DJANGO_SECRET_KEY=please-change-this-secret-key
DJANGO_DEBUG=0

# 允许访问的域名/IP，逗号分隔；部署脚本会自动追加服务器 IP 与你提供的域名
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,8ms.ai,www.8ms.ai

# CSRF 可信来源（HTTPS 部署后必须填写 https:// 前缀的域名）
CSRF_TRUSTED_ORIGINS=https://8ms.ai,https://www.8ms.ai

# ──── MySQL ──────────────────────────────────────────────────
# 部署脚本会按此账号自动创建数据库和用户
DB_NAME=aiproject
DB_USER=aiprogram
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# CREATE USER 时使用，与上面保持一致
APP_DB_NAME=aiproject
APP_DB_USER=aiprogram
APP_DB_PASSWORD=change-me

# ──── 上游 OpenRouter 默认参数（也可在网关里维护多个后端） ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ──── CORS ───────────────────────────────────────────────────
# 同域部署时留空即可；如果 8ms_code 部署在另一域名再填写
CORS_ALLOWED_ORIGINS=

# ──── Cookie 安全（HTTPS 部署改为 1） ──────────────────────────
CSRF_COOKIE_SECURE=1
SESSION_COOKIE_SECURE=1

# ──── 首次部署默认创建的超级管理员（部署后请立即修改密码！） ──
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@8ms.ai
DJANGO_SUPERUSER_PASSWORD=Admin@123456
