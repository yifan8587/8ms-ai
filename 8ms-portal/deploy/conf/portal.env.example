# ============================================================
#  8MS.AI 前端门户（Next.js / 8ms_code）运行时环境变量
#  部署脚本会把此文件复制到 /etc/8ms-portal/portal.env
#  并由 systemd（8ms-portal.service）加载
# ============================================================

# ──── Node / Next.js ────────────────────────────────────────
NODE_ENV=production
PORT=3013

# ──── 后端 API 地址 ──────────────────────────────────────────
# 服务器端代理（Next.js route /api/backend/[...path]）使用的地址，
# 因为前后端部署在同一台服务器，直接走 127.0.0.1，不绕公网。
BACKEND_API_BASE_URL=http://127.0.0.1:8090/api

# 浏览器端默认走同源代理 /api/backend/，无需配置 NEXT_PUBLIC_API_BASE_URL
# 如需让浏览器直接访问其他后端，可在此填写完整 https:// URL
# NEXT_PUBLIC_API_BASE_URL=

# ──── 站点信息（可选） ──────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=8MS.AI
NEXT_PUBLIC_SITE_URL=https://www.8ms.ai

# ──── 登录 / 注册成功后的跳转目标 ────────────────────────────
# 默认硬跳转到 /console/，让用户进入 Vue 管理后台（同域同 localStorage 实现 SSO）
# 改为 "/" 可保留旧行为：登录后停留在门户首页
# 也支持完整 URL：https://other.example.com/dashboard
NEXT_PUBLIC_POST_LOGIN_REDIRECT=/console/chat
