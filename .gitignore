# ─────────────────────────────────────────────────────────────────────────────
# 仓库根级忽略：仅追踪 aiprogram/、8ms-portal/、README.md、文档与运维脚本
# ─────────────────────────────────────────────────────────────────────────────

# 服务器运行时与系统目录
/containerd/
/backups/

# 历史发布的 tar.gz / zip / 备份（绝对不要再提交进仓库）
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# 误解压的发布目录（防止再次混入历史）
/8ms-release-*/
/aiprogram-release-*/

# .git 备份
.git.backup-*
.git.bak*

# ─────────────────────────────────────────────────────────────────────────────
# 密钥与环境变量（任何位置）
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!*.env.example
backend.env
portal.env
*.pem
*.key
id_rsa
id_ed25519
*.crt
*.p12

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境（任何位置都忽略）
venv/
.venv/
env/
ENV/

# Django
*.sqlite3
*.sqlite3-journal
db.sqlite3
/aiprogram/backend/staticfiles/
/aiprogram/backend/media/
/aiprogram/backend/uploads/

# ─────────────────────────────────────────────────────────────────────────────
# Node.js / 前端构建
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
.next/
.turbo/
dist/
build/
out/
.cache/
.parcel-cache/
.nuxt/

# npm / pnpm / yarn 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
# 编辑器 / IDE / 操作系统
# ─────────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────────────────────
# 日志与运行时
# ─────────────────────────────────────────────────────────────────────────────
*.log
logs/
*.pid
*.seed
*.pid.lock
